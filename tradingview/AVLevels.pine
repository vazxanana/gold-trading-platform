//@version=6
// ─── A / V LEVELS v1.0 ──────────────────────────────────────────────────────
// Marks the A-tops and V-bottoms of the CLOSING-PRICE line as levels:
//
//   • An "A" is a closing-price peak (line rises into it and falls away),
//     a "V" is a closing-price trough — detected with a configurable
//     strength (bars each side, default 1 = the sharpest pure A/V shape).
//   • Optional sharpness filter: both legs of the A/V must move at least
//     N × ATR(14) in closes — filters shallow wiggles, 0 = off.
//   • Each A/V puts a level line at its closing price, labeled "A" or "V"
//     at the pivot, extended right until price takes it:
//         candle CLOSES through the level  → line ends there (real break)
//         only a WICK trades through       → line ends as a RED DASHED
//                                            line (liquidity sweep)
//   • "Keep only last A and last V" replaces older untaken levels of the
//     same kind for a clean chart; broken/swept lines stay as history and
//     age out via the max-kept setting.
indicator("A/V Levels", "AVLevels", overlay = true, max_lines_count = 500, max_labels_count = 500)

k       = input.int(1, "Strength (bars each side)", minval = 1)
minAtr  = input.float(0.0, "Min leg size (ATR mult, 0 = off)", minval = 0, step = 0.1)
onlyLast = input.bool(false, "Keep only last A and last V")
maxKeep = input.int(12, "Max levels kept per side")

colA    = input.color(#FB7185, "A level", group = "Colors")
colV    = input.color(#4ADE80, "V level", group = "Colors")
colSweep = input.color(color.red, "Swept — dashed line", group = "Colors")
colTxt  = input.color(color.white, "Label text", group = "Colors")

atr = ta.atr(14)
pa = ta.pivothigh(close, k, k)
pv = ta.pivotlow(close, k, k)

var lvP  = array.new<float>()
var lvIsV = array.new<bool>()
var lvSt = array.new<int>()        // 0 live, 2 broken, 3 swept
var lvLn = array.new<line>()
var lvLb = array.new<label>()

// replace older untaken levels of the same kind (clean-chart mode)
f_dropLive(isV) =>
    if array.size(lvP) > 0
        for j = array.size(lvP) - 1 to 0
            if array.get(lvSt, j) == 0 and array.get(lvIsV, j) == isV
                line.delete(array.get(lvLn, j))
                label.delete(array.get(lvLb, j))
                array.remove(lvP, j)
                array.remove(lvIsV, j)
                array.remove(lvSt, j)
                array.remove(lvLn, j)
                array.remove(lvLb, j)

f_add(isV, p, pT) =>
    if onlyLast
        f_dropLive(isV)
    col = isV ? colV : colA
    array.push(lvP, p)
    array.push(lvIsV, isV)
    array.push(lvSt, 0)
    array.push(lvLn, line.new(math.round(pT), p, time, p, xloc = xloc.bar_time, color = color.new(col, 20), width = 1))
    array.push(lvLb, label.new(math.round(pT), p, isV ? "V" : "A", xloc = xloc.bar_time, style = isV ? label.style_label_up : label.style_label_down, color = color.new(color.black, 100), textcolor = colTxt, size = size.small))
    while array.size(lvP) > 2 * maxKeep
        line.delete(array.get(lvLn, 0))
        label.delete(array.get(lvLb, 0))
        array.remove(lvP, 0)
        array.remove(lvIsV, 0)
        array.remove(lvSt, 0)
        array.remove(lvLn, 0)
        array.remove(lvLb, 0)

if barstate.isconfirmed
    // confirmed A: closing-price peak at bar k back
    if not na(pa)
        legIn = close[k] - close[2 * k]
        legOut = close[k] - close
        if minAtr == 0 or math.min(legIn, legOut) >= minAtr * nz(atr, 0)
            f_add(false, close[k], time[k])
    // confirmed V: closing-price trough at bar k back
    if not na(pv)
        legIn = close[2 * k] - close[k]
        legOut = close - close[k]
        if minAtr == 0 or math.min(legIn, legOut) >= minAtr * nz(atr, 0)
            f_add(true, close[k], time[k])

    // level lifecycle: extend while untaken; a candle CLOSURE through the
    // level is the real break, a wick-only take is a sweep (red dash)
    if array.size(lvP) > 0
        for i = 0 to array.size(lvP) - 1
            if array.get(lvSt, i) == 0
                p = array.get(lvP, i)
                isV = array.get(lvIsV, i)
                ln = array.get(lvLn, i)
                closeThrough = isV ? close < p : close > p
                wickThrough = isV ? low < p : high > p
                if closeThrough
                    line.set_x2(ln, time)
                    array.set(lvSt, i, 2)
                else if wickThrough
                    line.set_x2(ln, time)
                    line.set_style(ln, line.style_dashed)
                    line.set_color(ln, colSweep)
                    array.set(lvSt, i, 3)
                else
                    line.set_x2(ln, time)
